substitutions:
  name: env-ai-agent
  friendly_name: "Env AI Agent"

esphome:
  name: ${name}
  friendly_name: ${friendly_name}
  on_boot:
    priority: -100
    then:
      - light.turn_on:
          id: status_strip
          effect: "Indicator"

esp32:
  board: esp32-s3-devkitc-1
  framework:
    type: esp-idf

psram:
  mode: octal
  speed: 80MHz

logger:
  level: DEBUG

api:

ota:
  - platform: esphome

wifi:
  networks:
    - ssid: !secret wifi_ssid
      password: !secret wifi_password
  ap:
  reboot_timeout: 0s
  power_save_mode: none
  fast_connect: true

captive_portal:

i2c:
  sda: GPIO8
  scl: GPIO9
  scan: true
  frequency: 400kHz
  id: bus_i2c

i2s_audio:
  - id: bus_in
    i2s_lrclk_pin: GPIO41
    i2s_bclk_pin: GPIO42

  - id: bus_out
    i2s_lrclk_pin: GPIO39
    i2s_bclk_pin: GPIO16

microphone:
  - platform: i2s_audio
    id: mic_inmp441
    i2s_audio_id: bus_in
    i2s_din_pin: GPIO38
    adc_type: external
    sample_rate: 16000
    bits_per_sample: 16bit
    channel: left
    pdm: false

speaker:
  - platform: i2s_audio
    id: speaker_out
    i2s_audio_id: bus_out
    i2s_dout_pin: GPIO14
    dac_type: external
    channel: mono
    buffer_duration: 500ms
    timeout: never

media_player:
  - platform: speaker
    id: media_out
    name: "VA Media Player"
    volume_min: 0.0
    volume_max: 1.0
    buffer_size: 10000
    announcement_pipeline:
      speaker: speaker_out
      num_channels: 1
      sample_rate: 16000
      format: FLAC

voice_assistant:
  id: va
  microphone: mic_inmp441
  media_player: media_out
  use_wake_word: false
  noise_suppression_level: 2
  auto_gain: 31dBFS
  volume_multiplier: 2

rtttl:
  output: buzzer_out
  id: buzzer

button:
  - platform: template
    name: "VA Start Button"
    id: va_start_button
    on_press:
      - rtttl.play: "beep:d=8,o=6,b=120:c"
      - voice_assistant.start:

binary_sensor:
  - platform: gpio
    pin:
      number: GPIO7
      mode: INPUT_PULLUP
      inverted: true
    name: "Physical VA Button"
    filters:
      - delayed_on: 50ms
    on_press:
      - rtttl.play: "beep:d=8,o=6,b=120:c"
      - voice_assistant.start:

sensor:
  - platform: dht
    pin: GPIO21
    model: DHT22
    temperature:
      name: "Room Temperature"
      id: temp_dht
    humidity:
      name: "Room Humidity"
      id: hum_dht
    update_interval: 60s

  - platform: bh1750
    i2c_id: bus_i2c
    name: "Room Illumination"
    id: lux_bh
    address: 0x23
    update_interval: 60s

text_sensor:
  - platform: template
    name: "Current Environment Summary"
    id: env_summary
    update_interval: 60s
    lambda: |-
      float t = id(temp_dht).state;
      float h = id(hum_dht).state;
      float l = id(lux_bh).state;

      if (std::isnan(t) || std::isnan(h) || std::isnan(l)) {
        return {"확인할 수 없습니다"};
      }

      char buf[80];
      snprintf(buf, sizeof(buf),
               "온도 %.0f도, 습도 %.0f%%, 조도 %.0f럭스",
               t, h, l);

      return {buf};

globals:
  - id: temp_level
    type: int
    restore_value: no
    initial_value: '0'

  - id: hum_level
    type: int
    restore_value: no
    initial_value: '0'

number:
  - platform: template
    name: "LED Brightness"
    id: led_brightness
    optimistic: true
    restore_value: true
    min_value: 0
    max_value: 255
    step: 5
    initial_value: 100

font:
  - file: "gfonts://Roboto"
    id: font_oled_big
    size: 16

display:
  - platform: ssd1306_i2c
    i2c_id: bus_i2c
    model: "SSD1306 128x64"
    address: 0x3C
    update_interval: 1s
    lambda: |-
      it.fill(COLOR_OFF);

      float t = id(temp_dht).state;
      float h = id(hum_dht).state;
      float l = id(lux_bh).state;

      if (std::isnan(t)) {
        it.printf(0, 0, id(font_oled_big), "Temp: --.- C");
      } else {
        it.printf(0, 0, id(font_oled_big), "Temp: %.1f C", t);
      }

      if (std::isnan(h)) {
        it.printf(0, 21, id(font_oled_big), "Humi: --.- %%");
      } else {
        it.printf(0, 21, id(font_oled_big), "Humi: %.1f %%", h);
      }

      if (std::isnan(l)) {
        it.printf(0, 42, id(font_oled_big), "Lux : ----");
      } else {
        it.printf(0, 42, id(font_oled_big), "Lux : %.0f lx", l);
      }

switch:
  - platform: gpio
    pin: GPIO48
    id: relay_out
    name: "Main Relay"
    icon: "mdi:power"

light:
  - platform: esp32_rmt_led_strip
    pin: GPIO1
    chipset: ws2812
    rgb_order: GRB
    num_leds: 10
    id: status_strip
    name: "Status LED Strip"
    restore_mode: ALWAYS_ON

    effects:
      - addressable_lambda:
          name: "Indicator"
          update_interval: 1s
          lambda: |-
            int b = (int) id(led_brightness).state;

            if (b < 0) b = 0;
            if (b > 255) b = 255;

            it.all() = Color(0, 0, 0);

            // LED 1~5 : 온도 표시, 주황색
            for (int i = 0; i < id(temp_level); i++) {
              it[i] = Color(b, b / 2, 0);
            }

            // LED 6~10 : 습도 표시, 파란색
            for (int i = 0; i < id(hum_level); i++) {
              it[5 + i] = Color(0, 0, b);
            }

interval:
  - interval: 60s
    then:
      - lambda: |-
          float t = id(temp_dht).state;
          float h = id(hum_dht).state;

          // 온도: 0~10도 1칸, 11~20도 2칸, 21~30도 3칸, 31~40도 4칸, 41도 이상 5칸
          if (std::isnan(t) || t < 0) {
            id(temp_level) = 0;
          } else if (t <= 10) {
            id(temp_level) = 1;
          } else if (t <= 20) {
            id(temp_level) = 2;
          } else if (t <= 30) {
            id(temp_level) = 3;
          } else if (t <= 40) {
            id(temp_level) = 4;
          } else {
            id(temp_level) = 5;
          }

          // 습도: 5단계, 20% 단위
          if (std::isnan(h)) {
            id(hum_level) = 0;
          } else if (h <= 20) {
            id(hum_level) = 1;
          } else if (h <= 40) {
            id(hum_level) = 2;
          } else if (h <= 60) {
            id(hum_level) = 3;
          } else if (h <= 80) {
            id(hum_level) = 4;
          } else {
            id(hum_level) = 5;
          }

      - light.turn_on:
          id: status_strip
          effect: "Indicator"

output:
  - platform: ledc
    pin: GPIO40
    id: buzzer_out
